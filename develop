#!/usr/bin/env bash

#
# ./develop
#   This is a helper script that wraps the typical commands you will execute on the Docker container. It saves the developer
#   from needing to explicitly run the commands through docker-compose.
#
#   See the comments in the script below for more detailed information.
#

# Create docker compose command to run
COMPOSE="docker compose -f docker-compose.dev.yml"

# Load variables from .env. Variables already present in the environment win,
# which matches how docker compose itself resolves them.
if [ -f .env ]; then
    while IFS='=' read -r name value; do
        case "$name" in ''|'#'*) continue ;; esac
        [ -z "${!name+x}" ] && export "$name=$value"
    done < .env
fi

PORT="${PORT:-80}"

# If we pass any arguments...
if [ $# -gt 0 ];then
    # If "composer" is used, pass-thru to "composer"
    # inside a new container
    if [ "$1" == "composer" ]; then
        shift 1
        $COMPOSE run --rm \
            -w /var/www \
            app \
            composer "$@"

    # If "serve" is used, run built-in webserver,
    # and expose it on the PORT from .env
    elif [ "$1" == "serve" ]; then
        shift 1
        echo "Serving the site on http://localhost:${PORT} (inside the container PHP listens on :80)"
        $COMPOSE run --service-ports --rm \
            -w /var/www \
            app \
            php -dxdebug.start_with_request=yes -S 0.0.0.0:80 -t ./web "$@"

    # If "test" is used, run unit tests,
    # pass-thru any extra arguments to phpunit
    elif [ "$1" == "test" ]; then
        shift 1
        $COMPOSE run --rm \
            -w /var/www \
            app \
            php -dxdebug.start_with_request=yes ./vendor/bin/phpunit "$@" --testdox

    # If "php" is used, run php interpreter,
    # pass-thru any extra arguments to php
    elif [ "$1" == "php" ]; then
        shift 1
        rm -rf ./storage/cache/*
        $COMPOSE run --rm -w /var/www app php "$@"

    # Else, pass-thru args to docker-compose
    else
        $COMPOSE "$@"
    fi

else
    $COMPOSE ps
fi
