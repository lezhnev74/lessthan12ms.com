{
  "name": "lezhnev74/textsite",
  "description": "A text website engine made for easy IDE driven publishing",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Dmitriy Lezhnev",
      "email": "lezhnev.work@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "nesbot/carbon": "^3.9",
    "league/commonmark": "^2.7",
    "slim/slim": "^4.14",
    "nyholm/psr7": "^1.8",
    "nyholm/psr7-server": "^1.1",
    "php-di/php-di": "^7.0",
    "vlucas/phpdotenv": "^5.6",
    "phlak/config": "^10.0",
    "monolog/monolog": "^3.8",
    "eftec/bladeone": "^4.19",
    "voku/html-min": "^5.0",
    "cocur/slugify": "^4.6",
    "mibe/feedwriter": "^1.1"
  },
  "autoload": {
    "psr-4": {
      "Textsite\\": "src/"
    },
    "files": [
      "src/Infrastructure/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require-dev": {
    "roave/security-advisories": "dev-master",
    "phpunit/phpunit": "^13.4"
  }
}
